<?xml version="1.0" encoding="UTF-8"?>
<!--
    SPDX-FileCopyrightText: 2026 Bernard Ladenthin <bernard.ladenthin@gmail.com>

    SPDX-License-Identifier: Apache-2.0

    Only reason this file exists: <pluginGroups>. Without net.ladenthin in it, Maven cannot
    resolve the short form `mvn srcmorph:generate` and the goal-prefix half of the integration
    test would silently degrade into the fully-qualified-coordinates form, which proves nothing
    about the prefix the plugin declares.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <pluginGroups>
        <pluginGroup>net.ladenthin</pluginGroup>
    </pluginGroups>
</settings>
